<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RoslynAnalysersVersion>5.1.2</RoslynAnalysersVersion>
    <ReactiveUIPrimitivesVersion>9.0.0</ReactiveUIPrimitivesVersion>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageVersion Include="ReactiveUI.Primitives" Version="$(ReactiveUIPrimitivesVersion)" />
    <PackageVersion Include="ReactiveUI.Primitives.Reactive" Version="$(ReactiveUIPrimitivesVersion)" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="StyleSharp.Analyzers" Version="$(RoslynAnalysersVersion)" />
    <PackageVersion Include="PerformanceSharp.Analyzers" Version="$(RoslynAnalysersVersion)" />
    <PackageVersion Include="SecuritySharp.Analyzers" Version="$(RoslynAnalysersVersion)" />
    <PackageVersion Include="System.Management" Version="10.0.12" />
    <PackageVersion Include="System.Resources.Extensions" Version="10.0.12" />
    <PackageVersion Include="TUnit" Version="1.73.19" />
    <PackageVersion Include="Nuke.Common" Version="10.1.0" />
    <PackageVersion Include="CP.Nuke.BuildTools" Version="3.0.2" />
    <PackageVersion Include="NuGet.Packaging" Version="7.9.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

</Project>
